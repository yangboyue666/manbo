<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_mode"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/mode_php"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PHP 轮询 (send.php/get.php)"
                android:checked="true" />

            <RadioButton
                android:id="@+id/mode_supabase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Supabase REST" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/backend_url"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_backend_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/backend_url_hint"
            android:inputType="textUri"
            android:singleLine="true"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hint_nickname"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nickname"
            android:inputType="text"
            android:singleLine="true"
            android:layout_marginBottom="24dp" />

        <CheckBox
            android:id="@+id/cb_adblock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="广告拦截"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save"
            android:background="@color/primary"
            android:textColor="@color/white" />
    </LinearLayout>
</ScrollView>
