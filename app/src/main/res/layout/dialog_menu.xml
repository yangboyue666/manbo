<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#33000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/menu_bookmark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:padding="15dp"
                android:src="@drawable/ic_bookmark"
                android:tint="@color/primary"
                android:background="@drawable/bg_home_icon"
                android:contentDescription="@string/bookmarks" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bookmarks"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_chat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:padding="15dp"
                android:src="@drawable/ic_chat"
                android:tint="@color/primary"
                android:background="@drawable/bg_home_icon"
                android:contentDescription="@string/chat" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_download"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:padding="15dp"
                android:src="@drawable/ic_download"
                android:tint="@color/primary"
                android:background="@drawable/bg_home_icon"
                android:contentDescription="@string/download" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/download"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_password"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:padding="15dp"
                android:src="@drawable/ic_lock"
                android:tint="@color/primary"
                android:background="@drawable/bg_home_icon"
                android:contentDescription="@string/password_vault" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/password_vault"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/menu_private"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:padding="15dp"
                android:src="@drawable/ic_shield"
                android:tint="@color/primary"
                android:background="@drawable/bg_home_icon"
                android:contentDescription="@string/private_mode" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/private_mode"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_addbookmark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:padding="15dp"
                android:src="@drawable/ic_star"
                android:tint="@color/primary"
                android:background="@drawable/bg_home_icon"
                android:contentDescription="@string/add_bookmark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_bookmark"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_desktop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp">

            <ImageView
                android:id="@+id/menu_desktop_icon"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:padding="15dp"
                android:src="@drawable/ic_desktop"
                android:tint="@color/primary"
                android:background="@drawable/bg_home_icon"
                android:contentDescription="@string/desktop_mode" />

            <TextView
                android:id="@+id/menu_desktop_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/desktop_mode"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:padding="15dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/primary"
                android:background="@drawable/bg_home_icon"
                android:contentDescription="@string/settings" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>